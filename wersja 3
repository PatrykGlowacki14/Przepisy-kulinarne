
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dr Donut Community</title>
<meta name="description" content="Welcome to Dr Donut Community. Explore events, rewards and the Minecraft community.">

<style>
:root {
    --blue: #258bdf;
    --blue-dark: #1266ad;
    --sky: #eaf6ff;
    --ink: #163956;
    --muted: #6c879e;
    --line: #d8eaf8;
    --white: #ffffff;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: #f8fcff;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font-family: inherit;
}

/* TOP BAR */

.topbar {
    background: #176caf;
    color: white;
    padding: 10px 15px;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* NAVIGATION */

.wrap {
    width: min(1160px, calc(100% - 44px));
    margin: auto;
}

.nav {
    height: 78px;
    background: rgba(255,255,255,.95);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
}

.nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 19px;
    font-weight: 900;
}

.brand span {
    color: var(--blue);
}

.brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: linear-gradient(135deg,#60c2ff,#1979d0);
    color: white;
    display: grid;
    place-items: center;
    font-size: 23px;
    box-shadow: 0 5px 15px #258bdf38;
}

.links {
    display: flex;
    align-items: center;
    gap: 25px;
    color: #58758e;
    font-size: 13px;
    font-weight: 700;
}

.links a:hover {
    color: var(--blue);
}

.nav-cta,
.primary {
    background: var(--blue);
    color: white;
    padding: 13px 20px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 13px;
    border: 0;
    cursor: pointer;
    transition: .2s;
}

.nav-cta:hover,
.primary:hover {
    background: var(--blue-dark);
    transform: translateY(-2px);
}

.menu-btn {
    display: none;
    background: white;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 13px;
    cursor: pointer;
}

/* HERO */

.hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 73% 50%,#a4d9ff 0%,transparent 42%),
      linear-gradient(115deg,#eff9ff 0%,#d9efff 55%,#c7e7ff 100%);
    min-height: 590px;
}

.hero:after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .17;
    pointer-events: none;
    background-image:
      linear-gradient(#ffffff 1px,transparent 1px),
      linear-gradient(90deg,#ffffff 1px,transparent 1px);
    background-size: 42px 42px;
}

.hero-inner {
    min-height: 590px;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.02fr .98fr;
    align-items: center;
    gap: 30px;
    padding-top: 45px;
    padding-bottom: 65px;
}

.eyebrow {
    color: #237dbb;
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 900;
    margin-bottom: 22px;
}

.hero h1 {
    font-size: clamp(43px,6vw,76px);
    line-height: .99;
    letter-spacing: -4px;
    font-weight: 900;
    color: #173e5e;
}

.hero h1 span {
    color: #278dde;
}

.hero-copy {
    margin-top: 23px;
    max-width: 455px;
    color: #5f7f99;
    line-height: 1.8;
    font-size: 15px;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
}

.secondary {
    background: white;
    color: #267cb8;
    border: 1px solid #c4e2f8;
    border-radius: 8px;
    padding: 13px 20px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
}

.secondary:hover {
    background: #f1f9ff;
}

.hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 30px;
}

.hero-tags span {
    background: #ffffffb9;
    border: 1px solid #d4eafb;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 11px;
    font-weight: 800;
    color: #527996;
}

/* MINECRAFT VOXEL ART */

.art {
    height: 420px;
    position: relative;
    isolation: isolate;
}

.art-sky {
    position: absolute;
    inset: 25px 0 0;
    border-radius: 30px;
    background: linear-gradient(150deg,#88ccff,#d4efff 70%,#f3fbff);
    overflow: hidden;
}

.pixel-cloud {
    position: absolute;
    height: 22px;
    width: 92px;
    background: white;
    box-shadow:
      20px -17px 0 white,
      40px -17px 0 white,
      40px 0 0 white,
      60px 0 0 white;
    opacity: .8;
}

.cloud-a {
    top: 65px;
    left: 45px;
    transform: scale(.7);
}

.cloud-b {
    top: 140px;
    right: 50px;
    transform: scale(.8);
}

.cloud-c {
    top: 35px;
    right: 130px;
    transform: scale(.5);
}

.sun {
    position: absolute;
    top: 54px;
    right: 56px;
    width: 62px;
    height: 62px;
    background: #fff5be;
    box-shadow: 0 0 50px #fff4aa;
}

.island {
    position: absolute;
    width: 360px;
    height: 160px;
    bottom: 65px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
}

.island-top {
    position: absolute;
    left: 0;
    right: 0;
    height: 82px;
    top: 0;
    background: #65c45b;
    clip-path: polygon(17% 0,83% 0,100% 52%,82% 100%,18% 100%,0 52%);
    filter: drop-shadow(0 10px 0 #398c45);
}

.island-dirt {
    position: absolute;
    top: 68px;
    left: 35px;
    right: 35px;
    height: 73px;
    background: repeating-linear-gradient(
        90deg,#a76a44 0 45px,#ba7950 45px 90px
    );
    border: 4px solid #93603f;
    box-shadow: 0 17px 0 #674d42;
}

.island-highlight {
    position: absolute;
    width: 120px;
    height: 13px;
    background: #91df72;
    top: 10px;
    left: 112px;
    z-index: 2;
}

.block {
    width: 57px;
    height: 57px;
    position: absolute;
    z-index: 5;
    background: #70c85e;
    border: 3px solid #479f48;
    box-shadow: inset -12px -10px #4ca54b;
}

.block.one {
    bottom: 128px;
    left: 40px;
}

.block.two {
    bottom: 128px;
    right: 30px;
    transform: scale(.72);
}

.water {
    position: absolute;
    height: 12px;
    width: 100%;
    bottom: 20px;
    background: #60c8f8;
    border-top: 4px solid #9be4ff;
}

.gem {
    position: absolute;
    z-index: 7;
    top: 81px;
    right: 95px;
    width: 76px;
    height: 76px;
    background: #4bbaf6;
    border: 7px solid #2395de;
    transform: rotate(45deg);
    box-shadow: 13px 13px 0 #1978b8;
}

.gem:after {
    content: "";
    position: absolute;
    height: 37px;
    width: 17px;
    background: #a1e5ff;
    top: 10px;
    left: 18px;
    transform: skew(-25deg);
}

.player {
    position: absolute;
    z-index: 8;
    bottom: 167px;
    left: 145px;
    width: 70px;
    height: 127px;
}

.player-head {
    position: absolute;
    top: 0;
    left: 9px;
    width: 49px;
    height: 49px;
    background: #d9a477;
    border: 4px solid #a97854;
    box-shadow: inset -9px -9px #bc8760;
}

.player-hair {
    position: absolute;
    top: -5px;
    left: 8px;
    height: 15px;
    width: 52px;
    background: #70452e;
}

.player-body {
    position: absolute;
    left: 5px;
    top: 52px;
    width: 57px;
    height: 47px;
    background: #258ee0;
    border: 4px solid #1764a5;
}

.player-leg {
    position: absolute;
    width: 24px;
    height: 29px;
    top: 98px;
    background: #344f8a;
    border: 3px solid #22375f;
}

.player-leg.left {
    left: 6px;
}

.player-leg.right {
    right: 6px;
}

.art-label {
    position: absolute;
    z-index: 9;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    color: #2475ad;
    background: #ffffffdc;
    border: 1px solid white;
    border-radius: 7px;
    padding: 10px 16px;
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: 900;
}

/* INFORMATION STRIP */

.info-strip {
    background: white;
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
}

.info-item {
    padding: 23px 18px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.info-item:last-child {
    border: 0;
}

.info-item strong {
    font-size: 13px;
    color: #267bb7;
}

.info-item small {
    font-size: 11px;
    color: #819aae;
}

/* GENERAL SECTIONS */

.section {
    padding: 90px 0;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
}

.kicker {
    color: #268ddd;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 13px;
}

.section h2 {
    font-size: clamp(29px,4vw,43px);
    letter-spacing: -1.7px;
    color: #183e5d;
}

.section-heading p {
    max-width: 420px;
    color: var(--muted);
    line-height: 1.7;
    font-size: 13px;
}

/* COMMUNITY BOARD */

.board {
    background: #e7f4ff;
    border: 1px solid #cde6fa;
    border-radius: 15px;
    padding: 25px;
    overflow: hidden;
}

.board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
}

.board-head h3 {
    font-size: 16px;
    color: #22577d;
}

.live {
    font-size: 10px;
    font-weight: 900;
    color: #238b65;
    background: #d8f8e9;
    padding: 7px 10px;
    border-radius: 30px;
}

.board-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 12px;
}

.board-item {
    background: white;
    border: 1px solid #d5e9f8;
    border-radius: 9px;
    padding: 20px;
}

.board-item small {
    color: #81a0b8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

.board-item h4 {
    margin-top: 10px;
    color: #247cb7;
    font-size: 19px;
}

.board-item p {
    margin-top: 7px;
    color: #849bad;
    font-size: 12px;
    line-height: 1.6;
}

/* FEATURES */

.feature-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr .8fr;
    gap: 17px;
}

.feature {
    position: relative;
    overflow: hidden;
    min-height: 270px;
    border-radius: 14px;
    padding: 27px;
    border: 1px solid #d4e9f8;
    background: white;
    transition: .2s;
}

.feature:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px #286a9c14;
}

.feature.large {
    background: linear-gradient(135deg,#d4edff,#f1f9ff);
}

.feature.dark {
    color: white;
    background: linear-gradient(145deg,#278bd4,#135caa);
    border: 0;
}

.feature h3 {
    margin: 20px 0 9px;
    font-size: 21px;
}

.feature p {
    max-width: 270px;
    color: #7893a7;
    font-size: 12px;
    line-height: 1.8;
}

.feature.dark p {
    color: #d2eaff;
}

.feature-visual {
    position: absolute;
    bottom: -9px;
    right: 12px;
    font-size: 78px;
    opacity: .85;
    filter: drop-shadow(0 9px 5px #23577c28);
}

.pill {
    display: inline-flex;
    padding: 7px 10px;
    border-radius: 5px;
    background: #e2f3ff;
    color: #267eb9;
    font-size: 9px;
    letter-spacing: .7px;
    font-weight: 900;
}

.pill.locked {
    background: #ffffff27;
    color: white;
    border: 1px solid #ffffff4d;
}

/* COMMUNITY PERKS */

.perks {
    background: linear-gradient(130deg,#dff2ff,#edf8ff);
    border-top: 1px solid #d4eafa;
    border-bottom: 1px solid #d4eafa;
}

.perk-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 17px;
}

.perk {
    background: white;
    border: 1px solid #d2e8f8;
    border-radius: 13px;
    overflow: hidden;
}

.perk-art {
    height: 145px;
    display: grid;
    place-items: center;
    font-size: 62px;
    background: linear-gradient(140deg,#b4e2ff,#e8f7ff);
}

.perk-content {
    padding: 22px;
}

.perk h3 {
    color: #215c88;
    font-size: 18px;
}

.perk p {
    color: #8099ad;
    font-size: 12px;
    line-height: 1.7;
    margin-top: 9px;
}

/* REFERRAL BONUS */

.referral-section {
    padding: 70px 0;
    background: #e5f3ff;
    border-top: 1px solid #cde5f8;
    border-bottom: 1px solid #cde5f8;
}

.referral-banner {
    background: linear-gradient(115deg,#197bc4,#55b5ef);
    border-radius: 20px;
    padding: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    color: white;
    position: relative;
    overflow: hidden;
    box-shadow: 0 15px 35px #258bdf25;
}

.referral-banner h2 {
    color: white;
    font-size: 34px;
    margin: 14px 0;
    letter-spacing: -1px;
}

.referral-banner p {
    color: #e1f3ff;
    font-size: 14px;
    line-height: 1.8;
    max-width: 480px;
}

.referral-label {
    display: inline-block;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    background: #ffffff25;
    border: 1px solid #ffffff55;
    padding: 9px 12px;
    border-radius: 5px;
}

.referral-reward {
    min-width: 190px;
    text-align: center;
    background: #ffffff20;
    border: 1px solid #ffffff55;
    border-radius: 15px;
    padding: 25px;
}

.referral-reward strong {
    display: block;
    font-size: 57px;
    font-weight: 900;
}

.referral-reward span {
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: bold;
}

.referral-footnote {
    font-size: 11px !important;
    margin-top: 14px;
    opacity: .8;
}

/* HOW TO JOIN */

.steps {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 15px;
}

.step-card {
    padding: 23px;
    border: 1px solid var(--line);
    background: white;
    border-radius: 12px;
}

.step-number {
    height: 34px;
    width: 34px;
    border-radius: 8px;
    background: #e1f2ff;
    color: #2588d0;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 900;
}

.step-card h3 {
    color: #245f8b;
    margin-top: 19px;
    font-size: 16px;
}

.step-card p {
    color: #8299ac;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.8;
}

/* COMMUNITY RULES */

.rules {
    background: #e7f5ff;
    border: 1px solid #cde6f9;
    border-radius: 15px;
    padding: 30px;
}

.rules-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 24px;
}

.rule {
    background: white;
    padding: 17px;
    border: 1px solid #d9eaf7;
    border-radius: 8px;
    color: #597c98;
    font-size: 12px;
    line-height: 1.7;
}

.rule b {
    color: #277eb8;
}

/* FINAL CTA */

.final-cta {
    margin: 0 auto 85px;
    padding: 58px 25px;
    text-align: center;
    border-radius: 17px;
    color: white;
    background: linear-gradient(120deg,#267fc2,#51b2ec);
    position: relative;
    overflow: hidden;
}

.final-cta:before,
.final-cta:after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    background: #ffffff13;
    transform: rotate(45deg);
}

.final-cta:before {
    left: -65px;
    top: -80px;
}

.final-cta:after {
    right: -65px;
    bottom: -90px;
}

.final-cta h2 {
    position: relative;
    color: white;
    font-size: 35px;
    letter-spacing: -1px;
}

.final-cta p {
    position: relative;
    color: #d9f0ff;
    font-size: 13px;
    margin-top: 12px;
}

.final-cta button {
    position: relative;
    margin-top: 23px;
    color: #216da8;
    background: white;
    padding: 14px 22px;
    border: 0;
    border-radius: 8px;
    font-weight: 900;
    cursor: pointer;
}

/* FOOTER */

footer {
    background: white;
    border-top: 1px solid var(--line);
    padding: 36px 0;
}

.footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    flex-wrap: wrap;
    color: #8297a8;
    font-size: 11px;
}

.footer-brand {
    font-weight: 900;
    font-size: 14px;
    color: #267eb8;
    margin-bottom: 8px;
}

/* VERIFICATION MODAL */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #1539579c;
    backdrop-filter: blur(7px);
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.modal.open {
    display: flex;
}

.modal-box {
    position: relative;
    width: min(460px,100%);
    background: white;
    border: 1px solid #d4eafa;
    border-radius: 17px;
    padding: 32px;
    box-shadow: 0 25px 80px #143d6030;
}

.close {
    position: absolute;
    top: 15px;
    right: 17px;
    background: #eff7fd;
    border: 0;
    border-radius: 7px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    color: #54758f;
}

.modal-title {
    font-size: 24px;
    color: #205c88;
    margin-bottom: 8px;
}

.modal-description {
    color: #7892a7;
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 22px;
}

.modal-step {
    display: none;
}

.modal-step.active {
    display: block;
}

.form-label {
    display: block;
    color: #436781;
    font-size: 12px;
    font-weight: 800;
    margin: 14px 0 8px;
}

.field {
    width: 100%;
    background: #f5faff;
    border: 1px solid #d1e7f7;
    border-radius: 8px;
    padding: 14px;
    font-size: 13px;
    color: #214d6b;
    outline: none;
}

.field:focus {
    border-color: #258bdf;
}

.edition-choice {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.edition-choice button {
    background: #f2f9ff;
    color: #3b7198;
    border: 1px solid #d4eafa;
    padding: 19px 10px;
    border-radius: 9px;
    font-weight: 900;
    cursor: pointer;
}

.edition-choice button.selected {
    background: #e1f2ff;
    border: 2px solid #278dde;
    color: #176cae;
}

.modal-action {
    width: 100%;
    margin-top: 19px;
    padding: 14px;
    border: 0;
    border-radius: 8px;
    background: #258bdf;
    color: white;
    font-weight: 900;
    cursor: pointer;
}

.modal-back {
    display: block;
    border: 0;
    background: none;
    color: #6b8da7;
    font-size: 12px;
    margin: 15px auto 0;
    cursor: pointer;
}

.notice {
    margin-top: 15px;
    color: #7591a8;
    font-size: 11px;
    line-height: 1.6;
}

.error {
    min-height: 16px;
    color: #c34c57;
    font-size: 12px;
    margin-top: 9px;
}

/* MOBILE */

@media(max-width:850px) {
    .hero-inner {
        grid-template-columns: 1fr;
    }

    .art {
        max-width: 580px;
        width: 100%;
        margin: auto;
    }

    .feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .feature.large {
        grid-column: span 2;
    }

    .links {
        gap: 13px;
    }
}

@media(max-width:650px) {
    .nav {
        height: 68px;
    }

