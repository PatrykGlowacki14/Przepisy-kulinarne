            <label class="form-label">
                Minecraft username
            </label>

            <input class="field" id="mcName"
                   placeholder="Enter your Minecraft nickname">

            <button class="modal-action" onclick="goStep(3)">
                Continue →
            </button>

            <button class="modal-back" onclick="goStep(1)">
                ← Back
            </button>

        </div>

        <!-- STEP 3 -->

        <div class="modal-step" id="step3">

            <label class="form-label">
                Email address
            </label>

            <input class="field" id="userEmail"
                   type="email" placeholder="name@gmail.com">

            <button class="modal-action" onclick="sendCode()">
                Send verification code →
            </button>

            <button class="modal-back" onclick="goStep(2)">
                ← Back
            </button>

            <p class="notice">
                A secure email service must be connected
                before codes can be sent. This page does not
                collect Google passwords.
            </p>

        </div>

        <!-- STEP 4 -->

        <div class="modal-step" id="step4">

            <label class="form-label">
                Six-digit email code
            </label>

            <input class="field" id="emailCode"
                   inputmode="numeric"
                   maxlength="6"
                   placeholder="000000">

            <button class="modal-action" onclick="verifyCode()">
                Confirm email →
            </button>

            <button class="modal-back" onclick="goStep(3)">
                ← Back
            </button>

        </div>

        <div class="error" id="formError"></div>

        <p class="notice">
            Email verification confirms the email address only.
            It does not independently prove ownership of the
            Minecraft account.
        </p>

