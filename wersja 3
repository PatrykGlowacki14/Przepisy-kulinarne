<!-- JAVASCRIPT -->

<script>

let selectedEdition = "";

/* MOBILE MENU */

function toggleMenu() {
    document.getElementById("links").classList.toggle("show");
}

/* OPEN VERIFICATION */

function openVerify() {
    document.getElementById("verifyModal").classList.add("open");
    document.body.style.overflow = "hidden";
}

/* CLOSE VERIFICATION */

function closeVerify() {
    document.getElementById("verifyModal").classList.remove("open");
    document.body.style.overflow = "";
}

/* SELECT MINECRAFT EDITION */

function chooseEdition(edition, button) {

    selectedEdition = edition;

    document.querySelectorAll(".edition-choice button").forEach(b => {
        b.classList.remove("selected");
    });

    button.classList.add("selected");

    clearError();
}

/* CHANGE VERIFICATION STEP */

function goStep(number) {

    clearError();

    if (number === 2 && !selectedEdition) {
        showError("Please choose Java or Bedrock.");
        return;
    }

    if (number === 3) {

        const name = document.getElementById("mcName").value.trim();

        if (!name) {
            showError("Please enter your Minecraft username.");
            return;
        }
    }

    document.querySelectorAll(".modal-step").forEach(step => {
        step.classList.remove("active");
    });

    document.getElementById("step" + number).classList.add("active");

    const titles = {
        1: ["Choose your edition", "Select the Minecraft version you play."],
        2: ["Your Minecraft profile", "Enter your in-game nickname."],
        3: ["Email confirmation", "Enter your email address to receive a code."],
        4: ["Check your inbox", "Enter the six-digit code from your email."]
    };

    document.getElementById("modalTitle").textContent = titles[number][0];

    document.getElementById("modalDescription").textContent = titles[number][1];
}

/* SEND EMAIL CODE */

async function sendCode() {

    clearError();

    const email = document.getElementById("userEmail").value.trim();
    const username = document.getElementById("mcName").value.trim();

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Please enter a valid email address.");
        return;
    }

    try {

        const response = await fetch("/api/send-code", {
            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                edition: selectedEdition,
                username: username,
                email: email
            })
        });

        if (!response.ok) {
            throw new Error("Email service unavailable.");
        }

        goStep(4);

    } catch (error) {

        showError(
            "Email sending is not connected yet. A backend is required."
        );

    }
}

/* VERIFY EMAIL CODE */

async function verifyCode() {

    clearError();

    const code = document.getElementById("emailCode").value.trim();
    const email = document.getElementById("userEmail").value.trim();

    if (!/^\d{6}$/.test(code)) {
        showError("Enter a valid six-digit code.");
        return;
    }

    try {

        const response = await fetch("/api/verify-code", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                email: email,
                code: code
            })

        });

        if (!response.ok) {
            throw new Error("The code could not be verified.");
        }

        const result = await response.json();

        if (result.verified === true) {

            document.getElementById("modalTitle").textContent =
                "Email confirmed!";

            document.getElementById("modalDescription").textContent =
                "Your email address has been verified.";

            document.querySelectorAll(".modal-step").forEach(step => {
                step.classList.remove("active");
            });

            document.getElementById("formError").textContent =
                "✓ Verification complete.";

        } else {

            showError("Incorrect or expired code.");

        }

    } catch (error) {

        showError("Verification service is not connected yet.");

    }

}

/* ERROR MESSAGES */

function showError(message) {
    document.getElementById("formError").textContent = message;
}

function clearError() {
    document.getElementById("formError").textContent = "";
}

/* CLOSE MODAL BY CLICKING OUTSIDE */

document.getElementById("verifyModal").addEventListener("click", function(e) {

    if (e.target === this) {
        closeVerify();
    }

});

/* CLOSE MENU AFTER NAVIGATION */

document.querySelectorAll(".links a").forEach(link => {

    link.addEventListener("click", () => {
        document.getElementById("links").classList.remove("show");
    });

});

</script>

